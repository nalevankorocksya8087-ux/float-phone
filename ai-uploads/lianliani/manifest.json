{
  "sdkVersion": "1.0",
  "id": "xindongxiaowu.pro",
  "name": "心动小屋 Pro",
  "version": "1.0.0",
  "author": "你的名字",
  "description": "一款以恋综模拟、嘉宾互动、剧情生成、观众频道围观为核心的沉浸式恋综模拟 APP。",
  "icon": "icon.png",
  "entry": "index.html",
  "permissions": [
    "app.data.read",
    "app.data.write",
    "characters.read",
    "characters.state.read",
    "characters.state.write",
    "characters.relations.read",
    "ai.generate",
    "chat.sendCard",
    "chat.write",
    "chat.requestReply",
    "ui.toast",
    "media.pick",
    "media.save"
  ],
  "resources": {
    "presets": ["presets.json"]
  },
  "extensions": {
    "chat": {
      "directives": [
        {
          "id": "xdxw-invite",
          "label": "发送邀约卡",
          "syntax": "[邀约:嘉宾:活动:备注]",
          "description": "当角色想主动邀请用户或另一位嘉宾进行一次约会/活动，并等待确认时使用。会同时携带当前关系设定与世界观上下文。",
          "card": {
            "appLabel": "心动小屋",
            "title": "约会邀请",
            "subtitle": "{{活动}}",
            "body": "{{备注}}",
            "status": "待确认",
            "accentColor": "#ff8fa3",
            "sections": [{
              "title": "邀约信息",
              "rows": [
                { "label": "邀请人", "value": "{{嘉宾}}" },
                { "label": "活动", "value": "{{活动}}" },
                { "label": "备注", "value": "{{备注}}" }
              ]
            }],
            "actions": [{ "label": "接受邀约" }, { "label": "婉拒" }]
          }
        },
        {
          "id": "xdxw-confession",
          "label": "发送告白卡",
          "syntax": "[告白:嘉宾:话语]",
          "description": "当角色决定正式表白、确认关系或做出关键情感表态时使用。通常用于节目后期（Day6-7）或关系已足够推进的节点。",
          "card": {
            "appLabel": "心动小屋",
            "title": "告白",
            "subtitle": "来自 {{嘉宾}}",
            "body": "{{话语}}",
            "accentColor": "#ff4d6d",
            "sections": [{
              "title": "告白内容",
              "rows": [
                { "label": "告白人", "value": "{{嘉宾}}" }
              ]
            }],
            "actions": [{ "label": "回应告白" }]
          }
        }
      ],
      "plusActions": [
        {
          "id": "xdxw-sms-panel",
          "label": "写心动短信",
          "entry": "sms-compose",
          "presentation": "panel",
          "panelHeight": "72vh",
          "description": "从聊天室打开心动小屋的匿名短信面板，快速为当前角色生成一条心动短信。"
        }
      ]
    }
  }
}
